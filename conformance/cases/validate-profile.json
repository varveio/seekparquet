    {
      "id": "validate-profile/key-order-within-page",
      "description": "Rows 2 and 3 (one page) are stored in descending order.",
      "requirements": [
        "KEY-3",
        "CHECK-2",
        "VAL-1"
      ],
      "requires": [
        "validate:profile"
      ],
      "dataset": "datasets/invalid/key-order-within-page",
      "detect": "validate:profile",
      "request": {
        "op": "validate",
        "level": "profile"
      },
      "expect": {
        "status": "refused",
        "code": "key_order"
      }
    },
    {
      "id": "validate-profile/key-order-duplicate",
      "description": "Key k04 is stored twice in one page (rows 4 and 5).",
