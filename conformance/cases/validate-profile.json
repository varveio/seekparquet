    {
      "id": "validate-profile/invalid-key-empty",
      "description": "The first key of the only part is empty (it still sorts first). Note: The manifest cannot express an empty min key, so it names the second key; a reader that compares first keys on open may report bounds_mismatch.",
      "requirements": [
        "KEY-2",
        "CHECK-2",
        "VAL-1"
      ],
      "requires": [
        "validate:profile"
      ],
      "dataset": "datasets/invalid/invalid-key-empty",
      "detect": "validate:profile",
      "request": {
        "op": "validate",
        "level": "profile"
      },
      "expect": {
        "status": "refused",
        "codes": [
          "invalid_key",
          "bounds_mismatch"
        ]
      }
    },
    {
      "id": "validate-profile/key-order-across-parts",
      "description": "Part 0 ends with k09, part 1 starts with k05. The manifest hides this by declaring part 0's max key as k04 (so the manifest bounds look disjoint). Note: The manifest's max key for part 0 is not the actual last key, so bounds_mismatch is also a correct report.",
      "requirements": [
        "KEY-3",
        "CHECK-2",
        "PART-3",
        "VAL-1"
      ],
      "requires": [
        "validate:profile"
      ],
      "dataset": "datasets/invalid/key-order-across-parts",
      "detect": "validate:profile",
      "request": {
        "op": "validate",
        "level": "profile"
      },
      "expect": {
        "status": "refused",
        "codes": [
          "key_order",
          "bounds_mismatch"
        ]
      }
    },
