    {
      "id": "validate-profile/empty",
      "requirements": [
        "VAL-1"
      ],
      "requires": [
        "validate:profile"
      ],
      "dataset": "datasets/empty",
      "request": {
        "op": "validate",
        "level": "profile"
      },
      "expect": {
        "status": "ok",
        "levels": {
          "structural": {
            "result": "complete"
          },
          "profile": {
            "result": "complete"
          }
        }
      }
    },
