{
  "group": "validate-structural",
  "target": "validator-structural",
  "generated": false,
  "description": "Validation at the structural level (section 8). validate always answers status ok with levels; an invalid dataset shows the level failed with the refusal code, and a dataset that cannot be opened shows structural failed. Core examples: hand-reviewed; their expectations are authoritative.",
  "cases": [
    {
      "id": "validate-structural/basic",
      "description": "A valid dataset: structural validation completes.",
      "requirements": [
        "VAL-1"
      ],
      "requires": [
        "validate:structural"
      ],
      "dataset": "datasets/basic",
      "request": {
        "op": "validate",
        "level": "structural"
      },
      "expect": {
        "status": "ok",
        "levels": {
          "structural": {
            "result": "complete"
          }
        }
      }
    },
    {
