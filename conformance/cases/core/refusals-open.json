        "MAN-1",
        "CHECK-1"
      ],
      "dataset": "datasets/invalid/manifest-not-json",
      "detect": "open",
      "request": {
        "op": "open"
      },
      "expect": {
        "status": "refused",
        "code": "invalid_manifest"
      }
    },
