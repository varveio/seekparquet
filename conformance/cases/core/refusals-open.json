{
  "group": "refusals-open",
  "target": "reader",
  "generated": false,
  "description": "Faults in the manifest, which a reader must detect when opening the dataset (reader_detect open in generators/faults.json), and faults in a part, which it must detect no later than the first read that routes to the part, or on verify (reader_detect touch). Core examples: hand-reviewed; their expectations are authoritative.",
  "cases": [
    {
      "id": "refusals-open/no-manifest",
      "description": "The part file is present but manifest.json is not. open must refuse with no_manifest.",
      "fault_id": "no-manifest",
      "requirements": [
        "LAYOUT-1",
        "CHECK-1"
      ],
      "dataset": "datasets/invalid/no-manifest",
      "detect": "open",
      "request": {
        "op": "open"
      },
      "expect": {
        "status": "refused",
        "code": "no_manifest"
      }
    },
    {
      "id": "refusals-open/manifest-not-json",
