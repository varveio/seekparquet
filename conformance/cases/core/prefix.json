    {
      "id": "prefix/binary-keys/04",
      "description": "prefix 7f ff ends in 0xFF: its successor is 0x80 (drop trailing 0xFF, increment), so 7f ff is included and 80 is not.",
      "requirements": [
        "RANGE-1",
        "KEY-3"
      ],
      "dataset": "datasets/binary-keys",
      "request": {
        "op": "range",
        "prefix_base64": "f/8=",
        "limit": 100000
      },
      "expect": {
        "status": "ok",
        "entries": [
          {
            "kind": "row",
            "key_base64": "f/8=",
            "values": [],
            "offset": 0
          }
        ]
      }
    },
