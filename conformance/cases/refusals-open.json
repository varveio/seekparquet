{
  "group": "refusals-open",
  "target": "reader",
  "description": "Faults a reader must detect when opening the dataset (detect: open).",
  "cases": [
    {
      "id": "refusals-open/stamp-missing",
      "description": "Parts carry no seekparquet.* footer metadata.",
      "requirements": [
        "STAMP-1",
        "STAMP-2",
        "CHECK-1"
      ],
      "dataset": "datasets/invalid/stamp-missing",
      "detect": "open",
      "request": {
        "op": "open"
      },
      "expect": {
        "status": "refused",
        "code": "stamp_mismatch"
      }
    },
    {
      "id": "refusals-open/stamp-wrong-schema-id",
      "description": "Footer seekparquet.schema_id differs from the manifest's.",
