{
  "group": "validate-digest",
  "target": "validator-digest",
  "description": "Validation at the digest level (section 8). Valid datasets complete. For an invalid dataset, validate still answers status ok and reports the level failed with the refusal code (it never answers refused); a dataset that cannot be opened reports structural failed.",
  "cases": [
    {
      "id": "validate-digest/empty",
      "requirements": [
        "VAL-2",
        "PART-5"
      ],
      "requires": [
        "validate:digest"
      ],
      "dataset": "datasets/empty",
      "request": {
        "op": "validate",
        "level": "digest"
      },
      "expect": {
        "status": "ok",
        "levels": {
          "digest": {
            "result": "complete",
            "checked": 0
          }
        }
      }
    },
