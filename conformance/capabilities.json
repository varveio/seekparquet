{
  "description": "Capability and conformance-target names used by adapters (hello), cases (requires) and the harness. The harness rejects any other name.",
  "capabilities": {
    "open": "open a dataset and perform the CHECK-1 checks",
    "range": "range and prefix reads (spec 6.2)",
    "list": "delimited listing (spec 6.3)",
    "projection": "projection of top-level non-repeated columns of the baseline physical types (COL-3)",
    "validate:structural": "validation at the structural level",
    "validate:profile": "validation at the profile level",
    "validate:full": "validation at the full level",
    "validate:digest": "validation at the digest level",
    "indexed-access": "the indexed-access suite (planned)"
  },
  "targets": {
    "reader": ["open", "range", "list", "projection"],
    "validator-structural": ["open", "validate:structural"],
    "validator-profile": ["open", "validate:structural", "validate:profile"],
    "validator-full": ["open", "validate:structural", "validate:profile", "validate:full"],
    "validator-digest": ["open", "validate:digest"],
    "indexed-access": ["open", "range", "list", "indexed-access"]
  }
}
